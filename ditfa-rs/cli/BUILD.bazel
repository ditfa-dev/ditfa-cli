load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "ditfa_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "ditfa_e2e_benchmark")

ditfa_rust_crate(
    name = "cli",
    crate_name = "ditfa_cli",
    extra_binaries = [
        "//ditfa-rs/bwrap:bwrap",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
)

multiplatform_binaries(
    name = "ditfa",
)

ditfa_e2e_benchmark(
    name = "ditfa-help",
    binaries = [":ditfa"],
)
