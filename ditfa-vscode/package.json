{
  "name": "ditfa-code",
  "displayName": "Ditfa Code",
  "description": "The AI coding agent that shows its work. Any model, your own keys or a Ditfa plan, checkpoints without Git, and a sandbox the engine enforces.",
  "version": "0.2.0",
  "publisher": "ditfa",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditfa-dev/ditfa-cli.git",
    "directory": "ditfa-vscode"
  },
  "bugs": {
    "url": "https://github.com/ditfa-dev/ditfa-cli/issues"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "agent",
    "coding assistant",
    "autonomous coding",
    "chat",
    "mcp",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "openrouter",
    "deepseek",
    "ollama",
    "lm studio",
    "local llm",
    "byok"
  ],
  "galleryBanner": {
    "color": "#04070d",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Ditfa Code executes commands and edits files in the workspace, which requires trust."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Ditfa Code runs commands and edits files on disk."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ditfa",
          "title": "Ditfa Code",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "ditfa": [
        {
          "id": "ditfa.chatView",
          "name": "Chat",
          "type": "webview",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Ditfa Code"
        }
      ]
    },
    "commands": [
      {
        "command": "ditfa.openChat",
        "title": "Open Chat",
        "category": "Ditfa",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ditfa.newThread",
        "title": "New Conversation",
        "category": "Ditfa",
        "icon": "$(add)"
      },
      {
        "command": "ditfa.interrupt",
        "title": "Stop Current Turn",
        "category": "Ditfa",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ditfa.selectProvider",
        "title": "Select Provider…",
        "category": "Ditfa"
      },
      {
        "command": "ditfa.signIn",
        "title": "Sign In to Ditfa",
        "category": "Ditfa"
      },
      {
        "command": "ditfa.signOut",
        "title": "Sign Out",
        "category": "Ditfa"
      },
      {
        "command": "ditfa.showAccount",
        "title": "Show Account & Usage",
        "category": "Ditfa"
      },
      {
        "command": "ditfa.addSelectionToChat",
        "title": "Add Selection to Chat",
        "category": "Ditfa"
      },
      {
        "command": "ditfa.addFileToChat",
        "title": "Add File to Chat",
        "category": "Ditfa"
      },
      {
        "command": "ditfa.explainSelection",
        "title": "Explain Selection",
        "category": "Ditfa"
      },
      {
        "command": "ditfa.inlineEdit",
        "title": "Edit Selection…",
        "category": "Ditfa"
      },
      {
        "command": "ditfa.fixProblems",
        "title": "Fix with Ditfa",
        "category": "Ditfa"
      },
      {
        "command": "ditfa.fixTerminalOutput",
        "title": "Fix Terminal Output",
        "category": "Ditfa"
      },
      {
        "command": "ditfa.reviewChanges",
        "title": "Review Uncommitted Changes",
        "category": "Ditfa"
      },
      {
        "command": "ditfa.openTerminal",
        "title": "Open Ditfa in Terminal",
        "category": "Ditfa",
        "icon": "$(terminal)"
      },
      {
        "command": "ditfa.restartServer",
        "title": "Restart Engine",
        "category": "Ditfa"
      },
      {
        "command": "ditfa.runDoctor",
        "title": "Run Diagnostics",
        "category": "Ditfa"
      },
      {
        "command": "ditfa.showLogs",
        "title": "Show Logs",
        "category": "Ditfa",
        "icon": "$(output)"
      },
      {
        "command": "ditfa.locateBinary",
        "title": "Locate ditfa Binary…",
        "category": "Ditfa"
      },
      {
        "command": "ditfa.openSettings",
        "title": "Open Settings",
        "category": "Ditfa",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ditfa.openTerminal",
          "when": "view == ditfa.chatView",
          "group": "1_ditfa@1"
        },
        {
          "command": "ditfa.showAccount",
          "when": "view == ditfa.chatView",
          "group": "1_ditfa@2"
        },
        {
          "command": "ditfa.runDoctor",
          "when": "view == ditfa.chatView",
          "group": "9_ditfa@1"
        },
        {
          "command": "ditfa.restartServer",
          "when": "view == ditfa.chatView",
          "group": "9_ditfa@2"
        },
        {
          "command": "ditfa.showLogs",
          "when": "view == ditfa.chatView",
          "group": "9_ditfa@3"
        }
      ],
      "editor/context": [
        {
          "command": "ditfa.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "ditfa@1"
        },
        {
          "command": "ditfa.inlineEdit",
          "when": "editorHasSelection",
          "group": "ditfa@2"
        },
        {
          "command": "ditfa.explainSelection",
          "when": "editorHasSelection",
          "group": "ditfa@3"
        }
      ],
      "explorer/context": [
        {
          "command": "ditfa.addFileToChat",
          "when": "!explorerResourceIsFolder",
          "group": "ditfa@1"
        }
      ],
      "terminal/context": [
        {
          "command": "ditfa.fixTerminalOutput",
          "when": "terminalTextSelected",
          "group": "ditfa@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ditfa.fixProblems",
          "when": "false"
        },
        {
          "command": "ditfa.locateBinary",
          "when": "false"
        },
        {
          "command": "ditfa.openSettings",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ditfa.openChat",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j"
      },
      {
        "command": "ditfa.addSelectionToChat",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorHasSelection"
      },
      {
        "command": "ditfa.inlineEdit",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Ditfa Code",
      "properties": {
        "ditfa.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `ditfa` executable. Leave empty to auto-detect (bundled binary, then `PATH`, then a local Cargo build).",
          "scope": "machine-overridable"
        },
        "ditfa.ditfaHome": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override `DITFA_HOME` (defaults to `~/.ditfa`). Determines where `config.toml`, credentials, and thread history live.",
          "scope": "machine-overridable"
        },
        "ditfa.provider": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model provider: `ditfa`, `openai`, `anthropic`, `gemini`, `openrouter`, `deepseek`, `ollama`, `lmstudio`, or any id from `config.toml`. Empty uses the engine default.",
          "scope": "resource"
        },
        "ditfa.model": {
          "type": "string",
          "default": "",
          "description": "Model to use. Empty uses the provider default.",
          "scope": "resource"
        },
        "ditfa.reasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "enumDescriptions": [
            "Use the model default",
            "Minimal reasoning",
            "Low reasoning",
            "Medium reasoning",
            "High reasoning",
            "Extra-high reasoning"
          ],
          "default": "",
          "description": "Reasoning effort for models that support it.",
          "scope": "resource"
        },
        "ditfa.approvalPolicy": {
          "type": "string",
          "enum": [
            "untrusted",
            "on-request",
            "never"
          ],
          "enumDescriptions": [
            "Ask before running anything not on the trusted list",
            "Ask only when the agent requests escalation",
            "Never ask (relies entirely on the sandbox)"
          ],
          "default": "on-request",
          "description": "When Ditfa asks before acting. The mode menu in the chat panel sets this.",
          "scope": "resource"
        },
        "ditfa.sandboxMode": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "enumDescriptions": [
            "The agent can read files but not write or run network commands",
            "The agent can write inside the workspace",
            "No sandbox — the agent has full access to the machine"
          ],
          "default": "workspace-write",
          "description": "Sandbox the engine applies to the agent. The mode menu in the chat panel sets this.",
          "scope": "resource"
        },
        "ditfa.allowNetwork": {
          "type": "boolean",
          "default": false,
          "description": "Let sandboxed commands reach the network, for example to install packages.",
          "scope": "resource"
        },
        "ditfa.maxTokensPerTurn": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Stop a turn once it has used this many tokens. `0` turns the limit off.",
          "scope": "resource"
        },
        "ditfa.showReasoning": {
          "type": "boolean",
          "default": true,
          "description": "Show the model's reasoning summary in the chat transcript."
        },
        "ditfa.autoContext.activeFile": {
          "type": "boolean",
          "default": true,
          "description": "Automatically attach the active file path as context with each message."
        },
        "ditfa.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "description": "Verbosity of the Ditfa Code output channel."
        },
        "ditfa.env": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Extra environment variables for the `ditfa` process. API keys belong in the panel's provider setup, which stores them in your system keychain; these are plain text.",
          "scope": "machine-overridable"
        }
      }
    }
  },
  "scripts": {
    "sync-protocol": "node scripts/sync-protocol.mjs",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "build": "pnpm run sync-protocol && node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/generate-icon.mjs",
    "test": "vitest run",
    "package": "pnpm run build && pnpm run check-bundle && vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "vscode:prepublish": "pnpm run build",
    "check-bundle": "node scripts/check-bundle-size.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.18",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "0.28.1",
    "ovsx": "^0.10.1",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  },
  "homepage": "https://ditfa.com/downloads",
  "extensionKind": [
    "workspace"
  ]
}
